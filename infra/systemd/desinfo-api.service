[Unit]
Description=desinfo FastAPI
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/desinfo
EnvironmentFile=-/srv/desinfo/.env
Environment=DESINFO_ROOT=/srv/desinfo
ExecStart=/srv/desinfo/venv/bin/uvicorn backend.api.app:app --host 127.0.0.1 --port 8700
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
